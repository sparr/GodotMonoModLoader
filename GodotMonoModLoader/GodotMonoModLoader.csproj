<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.2.1</Version>

        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <BaseDirectory>GodotMonoModLoader</BaseDirectory>
        <HarmonyVersion>2.4.2</HarmonyVersion>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Atomcraft">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\Atomcraft.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GodotSharp">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\GodotSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Godot.SourceGenerators" Version="4.4.0" >
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </PackageReference>
        <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)"  />
    </ItemGroup>

<!--    <PropertyGroup>-->
<!--        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
<!--        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>-->
<!--    </PropertyGroup>-->
    <UsingTask
            TaskName="ReplaceText"
            TaskFactory="RoslynCodeTaskFactory"
            AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <File ParameterType="System.String" Required="true"/>
            <Search ParameterType="System.String" Required="true"/>
            <Replace ParameterType="System.String" Required="true"/>
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                  var text = System.IO.File.ReadAllText(File);
                  text = text.Replace(Search, Replace);
                  System.IO.File.WriteAllText(File, text);
                  ]]>
            </Code>
        </Task>
    </UsingTask>
    
    <PropertyGroup>
        <GodotProjectDir>$(MSBuildProjectDirectory)</GodotProjectDir>
        <GodotTargetPlatform>Windows</GodotTargetPlatform>
        <GodotPlatform>Windows</GodotPlatform>
        <GodotTargetArchitecture>x86_64</GodotTargetArchitecture>
        <GodotApiConfiguration>Release</GodotApiConfiguration>
        <GodotRealTIsDouble>false</GodotRealTIsDouble>
        <EnableGodotGenerators>true</EnableGodotGenerators>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="GodotProjectDir" />
        <CompilerVisibleProperty Include="GodotTargetPlatform" />
        <CompilerVisibleProperty Include="GodotPlatform" />
        <CompilerVisibleProperty Include="GodotTargetArchitecture" />
        <CompilerVisibleProperty Include="GodotApiConfiguration" />
        <CompilerVisibleProperty Include="GodotRealTIsDouble" />
        <CompilerVisibleProperty Include="EnableGodotGenerators" />
    </ItemGroup>



    <Target Name="CreateZip" BeforeTargets="AfterBuild">

        <PropertyGroup>
            <Name>GodotMonoModLoader</Name>
            <ReleaseDir>$(MSBuildProjectDirectory)/../Release</ReleaseDir>
            <Dir>$(ReleaseDir)/$(Name)</Dir>
            <SubDir>$(Dir)/$(Name)</SubDir>
            <Zip>$(Dir).zip</Zip>
            
            <GDScriptsDir>$(ReleaseDir)/../GDScripts</GDScriptsDir>
            <DataDir>$(ProjectDir)Data</DataDir>
        </PropertyGroup>
        <ItemGroup>
            <GDScripts Include="$(GDScriptsDir)\**\*" />
            <Data Include="$(DataDir)\**\*" />
        </ItemGroup>
        
        
        <RemoveDir Directories="$(Dir)" />

        <MakeDir Directories="$(SubDir)" />

        <MSBuild Projects="..\ModLoaderBootstrap\ModLoaderBootstrap.csproj" BuildInParallel="$(BuildInParallel)" Targets="Clean;Build">
            <Output TaskParameter="TargetOutputs" ItemName="ModLoaderBootstrapOutput" />
        </MSBuild>

        <MSBuild Projects="..\AtomcraftPatcher\AtomcraftPatcher.csproj" BuildInParallel="$(BuildInParallel)" Targets="Clean;Publish"
                 Properties="Configuration=$(Configuration);
                  RuntimeIdentifier=win-x64;
                  PublishDir=$(Dir)"/>

        <MSBuild Projects="..\AtomcraftPatcher\AtomcraftPatcher.csproj" BuildInParallel="$(BuildInParallel)" Targets="Clean;Publish"
                 Properties="Configuration=$(Configuration);
                  RuntimeIdentifier=linux-x64;
                  PublishDir=$(Dir)"/>

        
        <!-- dinput8.dll is a native AOT win-x64 build. A Windows host does that
             unaided. Any other host needs the linker overrides in tools/win-aot-host,
             which stand on a Windows CRT installed by its setup.sh rather than shipped
             here, so there build.sh has to have run first and this only collects what it
             produced. Either way the zip is short one file rather than silently wrong. -->
        <MSBuild Condition="'$(OS)' == 'Windows_NT'"
                 Projects="..\ModLoaderHook\ModLoaderHook.csproj" BuildInParallel="$(BuildInParallel)" Targets="Clean;Publish"
                 Properties="Configuration=$(Configuration);
                  RuntimeIdentifier=win-x64;
                  PublishDir=$(Dir)"/>

        <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
            <HookPublished Include="$(MSBuildProjectDirectory)/../ModLoaderHook/bin/$(Configuration)/*/win-x64/publish/dinput8.dll" />
        </ItemGroup>

        <Copy   SourceFiles="@(HookPublished)"
                DestinationFolder="$(Dir)" />

        <Warning Condition="!Exists('$(Dir)/dinput8.dll')"
                 Text="dinput8.dll is not in the release zip. Build it first: tools/win-aot-host/build.sh ModLoaderHook/ModLoaderHook.csproj" />

        <!-- ModLoaderLauncher.exe is native AOT as well, on the same terms as
             dinput8.dll above. -->
        <MSBuild Condition="'$(OS)' == 'Windows_NT'"
                 Projects="..\ModLoaderLauncher\ModLoaderLauncher.csproj" BuildInParallel="$(BuildInParallel)" Targets="Clean;Publish"
                 Properties="Configuration=$(Configuration);
                  RuntimeIdentifier=win-x64;
                  PublishDir=$(Dir)"/>

        <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
            <LauncherPublished Include="$(MSBuildProjectDirectory)/../ModLoaderLauncher/bin/$(Configuration)/*/win-x64/publish/ModLoaderLauncher.exe" />
        </ItemGroup>

        <Copy   SourceFiles="@(LauncherPublished)"
                DestinationFolder="$(Dir)" />

        <Warning Condition="!Exists('$(Dir)/ModLoaderLauncher.exe')"
                 Text="ModLoaderLauncher.exe is not in the release zip. Build it first: tools/win-aot-host/build.sh ModLoaderLauncher/ModLoaderLauncher.csproj" />

        <Copy
                SourceFiles="$(ReleaseDir)/../$(Name).gd"
                DestinationFolder="$(Dir)"/>

        <ReplaceText
                File="$(Dir)/$(Name).gd"
                Search="@VERSION@"
                Replace="$(Version)" />
        <ReplaceText
                File="$(Dir)/$(Name).gd"
                Search="@HARMONY_VERSION@"
                Replace="$(HarmonyVersion)" />

        <Copy
                SourceFiles="@(ModLoaderBootstrapOutput)"
                DestinationFolder="$(SubDir)" />

        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(SubDir)" />

        <Copy
                SourceFiles="$(TargetDir)0Harmony.dll"
                DestinationFolder="$(SubDir)" />

        <Copy   Condition="Exists($(GDScriptsDir))"
                SourceFiles="@(GDScripts)"
                DestinationFiles="@(GDScripts->'$(SubDir)/%(RecursiveDir)%(Filename)%(Extension)')"/>
        
        <Copy   Condition="Exists($(DataDir))"
                SourceFiles="@(Data)"
                DestinationFiles="@(Data->'$(SubDir)/Data/%(RecursiveDir)%(Filename)%(Extension)')"/>
        
        <Copy
                SourceFiles="$(MSBuildProjectDirectory)/../README.md"
                DestinationFiles="$(Dir)/ModLoader.md"/>

        <Delete Files="$(Zip)" />

        <ZipDirectory
                SourceDirectory="$(Dir)"
                DestinationFile="$(Zip)"
                Overwrite="true" />

        <RemoveDir Directories="$(Dir)" />

        <Message
                Importance="high"
                Text="GodotMonoModLoader ZIP created: $(Zip)" />

    </Target>
    
</Project>
