<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Must match the runtime the game ships, because this assembly is loaded
             into the game's own CoreCLR rather than one of its own. -->
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
    </PropertyGroup>

    <!-- Deliberately no references. This assembly may land in an isolated load
         context, so it reaches the game's world purely by reflection; a compile-time
         reference to GodotSharp or Harmony would bind the wrong copy. -->

    <Target Name="RemoveDepsJson" AfterTargets="Build">
        <Delete Files="$(OutputPath)$(AssemblyName).deps.json" />
    </Target>

</Project>
